# macOS
.DS_Store

# editor settings
.vscode/

# Hugo asset pipeline cache
resources/_gen/
hugo_stats.json

# local environment files
.env

# Obsidian local state (keep app.json, templates.json, core-plugins.json and templates/ tracked)
**/.obsidian/workspace*.json
**/.obsidian/plugins/
**/.obsidian/appearance.json

# Hugo build output, produced by CI
/public/

# Hugo build lock (created in the site root on every build)
.hugo_build.lock
