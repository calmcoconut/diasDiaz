{{- $posts := where site.RegularPages "Section" "blog" -}}
{{- $index := slice -}}
{{- range $posts -}}
    {{- if not .Params.searchHidden -}}
        {{- $summary := partial "obsidian-plain.html" (dict "text" (.Summary | plainify | htmlUnescape)) -}}
        {{- $content := partial "obsidian-plain.html" (dict "text" (.Plain | htmlUnescape)) -}}
        {{- $item := dict "title" .Title "permalink" .RelPermalink "date" (.Date.Format "2006-01-02") "summary" $summary "content" $content -}}
        {{- $index = $index | append $item -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
